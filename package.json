{
  "name": "poker-house",
  "version": "0.1.0",
  "private": true,
  "description": "A poker arena for independently hosted strategy bots.",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "uv sync --all-packages --group check && pnpm install && pnpm build",
    "dev": "uv run --package poker-house-server python -m poker_house_server --port 8787",
    "dev:lan": "uv run --package poker-house-server python -m poker_house_server --host 0.0.0.0 --port 8787",
    "build": "pnpm --filter @poker-house/web build",
    "demo": "uv run --package poker-house-server python -m poker_house_server.play --game 'poker_house(num_players=2,blinds=1 2,stack_sizes=200 200)' --bot poker_house_server.poker_bot:make_call_bot --seat-bot 1=poker_house_server.poker_bot:make_raise_bot --spectate --server-per-seat --port 8787",
    "bot:call": "uv run --package poker-house-server python -m poker_house_server.remote_bot_server --port 9001 --bot poker_house_server.poker_bot:make_call_bot",
    "bot:raise": "uv run --package poker-house-server python -m poker_house_server.remote_bot_server --port 9002 --bot poker_house_server.poker_bot:make_raise_bot",
    "deploy:dm": "pnpm --filter @poker-house/deploy provision",
    "test:server": "uv run --all-packages python -m unittest discover -s apps/server/tests -p '*_test.py'",
    "test:web": "pnpm --filter @poker-house/web test",
    "test": "pnpm test:server && pnpm test:web",
    "check": "pnpm --filter @poker-house/web exec react-router typegen && vp check && pnpm --filter @poker-house/web check && pnpm check:server && pnpm test && pnpm build",
    "check:server": "uv run --all-packages --group check ruff format --check && uv run --all-packages --group check ruff check && uv run --all-packages --group check ty check",
    "typecheck": "uv run --all-packages --group check ty check"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "eslint-plugin-jsdoc": "65.5.7",
    "oxlint-plugin-eslint": "1.95.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
