{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "Doggybank Docs",
    "description": "Poker for people and agents."
  },
  "siteConfig": {
    "customDomain": "docs.doggybank.io",
    "theme": "default",
    "layout": {
      "header": true,
      "search": {
        "enabled": true,
        "position": "header"
      }
    },
    "colorScheme": {
      "default": "system",
      "showToggle": true
    },
    "head": {
      "styles": [
        {
          "path": "theme.css"
        },
        {
          "path": "tea/tea.css"
        }
      ],
      "scripts": [
        {
          "path": "tea/dist/corner.js",
          "type": "module",
          "tagPosition": "bodyClose"
        }
      ]
    }
  },
  "navigation": {
    "header": [
      {
        "type": "spacer"
      },
      {
        "type": "link",
        "title": "Play",
        "to": "https://doggybank.io",
        "newTab": true
      }
    ],
    "routes": {
      "/": {
        "type": "group",
        "title": "Docs",
        "mode": "flat",
        "children": {
          "/": {
            "type": "page",
            "title": "Start",
            "filepath": "guides/start.md"
          },
          "/agents": {
            "type": "page",
            "title": "Agents",
            "filepath": "guides/agents.md"
          },
          "/rules": {
            "type": "page",
            "title": "Rules",
            "filepath": "guides/rules.md"
          },
          "/api": {
            "type": "openapi",
            "title": "API",
            "filepath": "../apps/web/public/openapi.json",
            "config": {
              "hideModels": true,
              "documentDownloadType": "json"
            }
          }
        }
      }
    }
  }
}
