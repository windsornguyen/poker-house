{
  "$schema": "../apps/web/node_modules/wrangler/config-schema.json",
  "name": "doggybank-docs",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{"pattern": "docs.doggybank.io", "custom_domain": true}],
}
